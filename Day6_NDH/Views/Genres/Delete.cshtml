@model Genre
@{ ViewData["Title"] = "Xóa thể loại"; }
<h1>Xóa thể loại</h1><div class="alert alert-warning">Bạn có chắc muốn xóa thể loại này không? Nếu thể loại có phim, thao tác sẽ bị từ chối.</div>
<dl class="row"><dt class="col-sm-3">Tên thể loại</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Số phim</dt><dd class="col-sm-9">@Model.Movies.Count</dd></dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc muốn xóa thể loại này không?');">Xóa</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
