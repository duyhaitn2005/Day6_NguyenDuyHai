@model IEnumerable<Movie>
@{ ViewData["Title"] = "Danh sách phim"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Danh sách phim</h1><a asp-action="Create" class="btn btn-primary">Thêm phim</a></div>
<table class="table table-striped table-hover"><thead><tr><th>Tên phim</th><th>Ngày phát hành</th><th>Thời lượng</th><th>Thể loại</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach (var movie in Model) { <tr><td>@movie.Title</td><td>@movie.ReleaseDate.ToString("dd/MM/yyyy")</td><td>@movie.Duration phút</td><td>@movie.Genre?.Name</td><td class="text-end"><a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-warning">Sửa</a> <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-danger">Xóa</a></td></tr> }
</tbody></table>
